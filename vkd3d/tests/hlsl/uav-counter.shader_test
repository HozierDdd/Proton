[require]
shader model >= 5.0
format r32-uint

[uav 2]
format r32-uint
size (buffer, 1)
0

[compute shader todo]
RWStructuredBuffer<uint> u : register(u1);
RWBuffer<uint> u2 : register(u2);

    [numthreads(1, 1, 1)]
void main()
{
    u2[0] = u.IncrementCounter();
}

[test]
todo(sm<6 | msl) bug(mvk<=1.2.9) dispatch 1 1 1
probe uav-1 (0) i32(-11)
% IncrementCounter() returns the pre-increment value
probe uav-2 (0) i32(-12)

[compute shader todo]
RWStructuredBuffer<uint> u : register(u1);
RWBuffer<uint> u2 : register(u2);

    [numthreads(1, 1, 1)]
void main()
{
    u2[0] = u.DecrementCounter();
}

[test]
todo(sm<6 | msl) bug(mvk<=1.2.9) dispatch 1 1 1

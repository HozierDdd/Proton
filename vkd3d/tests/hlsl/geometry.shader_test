% If maxvertexcount() is insufficient, the excess vertices are ignored, no validation error or warning is emitted.
[geometry-shader]
struct gs_data
{
    float4 pos : SV_Position;
};

    [maxvertexcount(5)]
void main(point struct gs_data vin[1], inout TriangleStream<gs_data> vout)
{
    gs_data v;

    v.pos = float4(-1.0, 1.0, 0.0, 1.0);
    vout.Append(v);
    v.pos = float4(-1.0, -1.0, 0.0, 1.0);
    vout.Append(v);
    v.pos = float4(0.0, 1.0, 0.0, 1.0);
    vout.Append(v);
    v.pos = float4(0.0, -1.0, 0.0, 1.0);
    vout.Append(v);
    v.pos = float4(1.0, 1.0, 0.0, 1.0);
    vout.Append(v);
    v.pos = float4(1.0, -1.0, 0.0, 1.0);
    vout.Append(v);
}


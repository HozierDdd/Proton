probe rtv-0 (320, 290) f32(0.0, 0.0, 0.0, 0.0)

% Try different combinations of Append() and RestartStrip()
[geometry-shader]
struct gs_data
{
    float4 pos : SV_Position;
};

uniform uint variant;

    [maxvertexcount(10)]
void main(point struct gs_data vin[1], inout TriangleStream<gs_data> vout)
{
    gs_data v;

    v.pos = float4(-1.0, 1.0, 0.0, 1.0);
    vout.Append(v);
    v.pos = float4(-1.0, -1.0, 0.0, 1.0);
    vout.Append(v);
    v.pos = float4(0.0, 1.0, 0.0, 1.0);
    vout.Append(v);

    if (variant == 1 || variant == 4)
        vout.RestartStrip();

    v.pos = float4(0.0, -1.0, 0.0, 1.0);
    vout.Append(v);
    v.pos = float4(1.0, 1.0, 0.0, 1.0);
    vout.Append(v);

    if (variant == 3 || variant == 4)
        vout.RestartStrip();

    if (variant != 2)
    {
        v.pos = float4(1.0, -1.0, 0.0, 1.0);
        vout.Append(v);
    }
}

[pixel-shader]
float4 main() : SV_Target
{
    return float4(0.0, 1.0, 0.0, 1.0);
}


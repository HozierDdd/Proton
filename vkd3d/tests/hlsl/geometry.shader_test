% Points that are dropped because the strip is restarted do count towards the
% maximum vertex count, even if they never contributed to any primitive.
% It seems that RADV and radeonsi don't count them.
% The Vulkan spec doesn't seem to have precise wording for what should happen,
% so for the moment I'm leaving it as a todo.
[geometry-shader]
struct gs_data
{
    float4 pos : SV_Position;
};

    [maxvertexcount(3)]
void main(point struct gs_data vin[1], inout TriangleStream<gs_data> vout)
{
    gs_data v;

    v.pos = float4(-1.0, 1.0, 0.0, 1.0);
    vout.Append(v);
    vout.RestartStrip();
    v.pos = float4(-1.0, -1.0, 0.0, 1.0);
    vout.Append(v);
    v.pos = float4(0.0, 1.0, 0.0, 1.0);
    vout.Append(v);
    v.pos = float4(0.0, -1.0, 0.0, 1.0);
    vout.Append(v);
    v.pos = float4(1.0, 1.0, 0.0, 1.0);
    vout.Append(v);
    v.pos = float4(1.0, -1.0, 0.0, 1.0);
    vout.Append(v);
}


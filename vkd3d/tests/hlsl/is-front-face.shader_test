todo(glsl) probe (480, 240) f32(2.0, 1.0, 0.0, 0.0)

[require]
% vface is mapped in sm4 only with the backcompat option.
options: backcompat
shader model < 6.0

[pixel shader fail]
float4 main(uint a : TEXCOORD, float2 face : vface) : sv_target
{
    return float4(a, face.x, 0, 0);
}

[pixel shader fail(sm<3)]
float4 main(uint a : TEXCOORD, float face : vface) : sv_target
{
    return float4(a, face, 0, 0);
}

[test]
clear rtv-0 f32(0.0, 0.0, 0.0, 0.0)
draw triangle list 6
probe (160, 240) f32(2.0, -1.0, 0.0, 0.0)
probe (480, 240) f32(2.0,  1.0, 0.0, 0.0)

% uint, int, and bool are also allowed, but seem to be broken.
% Instead of returning -1 (or UINT_MAX) the back face returns nonsense values.
% bool is even worse, returning 0 for front face and 1 for back face.

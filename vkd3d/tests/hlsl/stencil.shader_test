[require]
shader model >= 4.0

[rtv-0]
size (2d, 64, 64)
format r8-uint

[dsv]
size (2d, 64, 64)
format d32-float-s8x24-uint

[srv-0]
size (2d, 64, 64)
format x32-typeless-g8x24-uint

[pixel shader]
Texture2D<uint4> tex : register(t0);

uint main(float4 pos : SV_Position) : SV_TARGET
{
    return tex[uint2(pos.xy)].g;
}

[test]
clear rtv-0 f32(0, 0, 0, 0)
clear dsv f32(0.5) u32(0x80)
copy dsv srv-0
depth always
draw quad
probe (32, 32) u8(0x80)

[require]
shader model >= 5.0
stencil-export

[pixel shader]
void main(out uint o[1] : SV_StencilRef)
{
    o[0] = 0xff;
}

[pixel shader]
void main(out uint1 o : SV_StencilRef)
{
    o = 0xff;
}

[pixel shader fail]
void main(out int o : SV_StencilRef)
{
    o = 0xff;
}

[pixel shader fail]
void main(out uint o[2] : SV_StencilRef)
{
    o[0] = 0xff;
    o[1] = 0x00;
}

[pixel shader fail]
uint4 main() : SV_StencilRef
{
    return uint4(0x00, 0x40, 0x80, 0xc0);
}

[pixel shader]
uint stencil_ref;

uint main() : SV_StencilRef
{
    return stencil_ref;
}

[test]
write cbv-0 (0) u32(0xa5)
depth never
stencil (always replace replace replace)
stencil-ref u32(0x40)
clear dsv f32(0.25) u32(0xcc)
todo(glsl) draw quad
copy dsv srv-0
depth always

[pixel shader]
Texture2D<uint4> tex : register(t0);

uint main(float4 pos : SV_Position) : SV_TARGET
{
    return tex[uint2(pos.xy)].g;
}

[test]
clear rtv-0 f32(0, 0, 0, 0)
draw quad
